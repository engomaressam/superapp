<![CDATA[{
  "expo": {
    "name": "ARIA",
    "slug": "aria-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aria.agent",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ARIA needs your location to book rides and find nearby services.",
        "NSMicrophoneUsageDescription": "ARIA uses voice input for hands-free interaction.",
        "NSCameraUsageDescription": "ARIA can scan documents and receipts when needed."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.aria.agent",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ARIA to use your location for ride booking and finding nearby services."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "aria"
  }
}
]]>
